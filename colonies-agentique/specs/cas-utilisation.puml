@startuml cas-utilisation
' Diagramme des cas d'utilisation de la plateforme colonies-agentique.
' Il sert aussi de liste de contrôle : un cas présent ici sans fichier dans cas-utilisation/ reste à rédiger.
left to right direction
skinparam packageStyle rectangle

actor "Chercheur" as Chercheur
actor "Pipeline CI" as CI
actor "Lecteur" as Lecteur
actor "API LLM" as API

rectangle "SIM : moteur de simulation" {
  usecase "UC-001 Exécuter un scénario" as UC001
  usecase "UC-002 Rejouer une exécution" as UC002
  usecase "UC-003 Vérifier une cible de reproduction" as UC003
  usecase "UC-004 Balayer des paramètres" as UC004
  usecase "UC-005 Aligner par docking" as UC005
  usecase "UC-006 Préparer les résumés d'une page" as UC006
  usecase "UC-007 Calculer les métriques R et G" as UC007
  usecase "UC-008 Vérifier le dépôt" as UC008
}

rectangle "PAGES : vulgarisation" {
  usecase "UC-010 Suivre un récit guidé" as UC010
  usecase "UC-011 Explorer un modèle" as UC011
  usecase "UC-012 Vérifier une reproduction" as UC012
  usecase "UC-013 Partager l'état d'une page" as UC013
  usecase "UC-014 Modifier la règle d'un agent" as UC014
  usecase "UC-015 Télécharger les données d'une page" as UC015
}

rectangle "LLM : campagnes d'agents" {
  usecase "UC-020 Exécuter une campagne d'agents LLM" as UC020
  usecase "UC-021 Rejouer une campagne" as UC021
}

Chercheur --> UC001
Chercheur --> UC002
Chercheur --> UC003
Chercheur --> UC004
Chercheur --> UC005
Chercheur --> UC006
Chercheur --> UC007
Chercheur --> UC008
CI --> UC008

Lecteur --> UC010
Lecteur --> UC011
Lecteur --> UC012
Lecteur --> UC013
Lecteur --> UC014
Lecteur --> UC015

Chercheur --> UC020
Chercheur --> UC021
UC020 --> API

UC003 ..> UC001 : <<include>>
UC004 ..> UC001 : <<include>>
UC005 ..> UC001 : <<include>>
UC006 ..> UC003 : <<include>>
@enduml
