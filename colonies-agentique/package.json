{
  "name": "colonies-agentique",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coordination sans contrôle central : fourmilières, ruches et systèmes d'agents (moteur de simulation)",
  "engines": { "node": ">=24.12" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "test": "node --test \"tests/core/**/*.test.ts\" \"tests/cli/**/*.test.ts\" tests/determinism.test.ts tests/conformance.test.ts tests/verify.test.ts \"outils/*.test.ts\"",
    "verify": "node outils/verify.ts",
    "replay": "node src/cli/replay.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "7.0.2"
  }
}
